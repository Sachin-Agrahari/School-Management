@{ Layout = null; }
<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>School ERP - Login</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="~/css/site.css" rel="stylesheet"></head><body class="login-page"><div class="login-shell"><div class="login-brand"><div class="brand-mark">S</div><h2>School ERP</h2><p>Smart School Management System</p></div><form method="post" class="login-card"><h4>Welcome back 👋</h4><p class="text-muted">Sign in to continue</p>@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}<label>Username</label><input class="form-control mb-3" name="username" placeholder="Enter username" required><label>Password</label><input type="password" class="form-control mb-3" name="password" placeholder="Enter password" required><label>Login As</label><select class="form-select mb-4" name="role"><option>Admin</option><option>Principal</option><option>Teacher</option><option>Student</option><option>Parent</option></select><button class="btn btn-primary w-100 py-2">Login</button><small class="text-muted d-block mt-3">Demo: any username/password. Role controls dashboard.</small></form></div></body></html>
