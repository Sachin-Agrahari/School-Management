@using Microsoft.AspNetCore.Http
@{
	var role = Context.Session.GetString("Role") ?? ""; var user = Context.Session.GetString("UserName") ?? "Guest";
}
<!doctype html>
<html>

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width,initial-scale=1">
	<title>EduCore School ERP</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

	
	<!-- Font Awesome -->
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
		  rel="stylesheet">


	<link rel="stylesheet" href="~/css/site.css">
	
</head>

<body>


	<div class="sidebar-overlay" id="sidebarOverlay"></div>
	<aside class="sidebar" id="sidebar">
		<div class="brand">
			<b>
				<i class="bi bi-mortarboard-fill"></i><span class="brand-text">EduCore</span>
			</b><small>School ERP</small>
		</div>
		<div class="label">MAIN MENU</div>
		<a class="menu" asp-controller="Dashboard" asp-action="Index">
			<i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span>
		</a>
		@if (role == "Admin" || role == "Principal" || role == "Teacher")
		{
			<a class="menu" asp-controller="Transport" asp-action="MenuTreeView">
				<i class="bi bi-list"></i><span>Menu Tree</span>
			</a>
			<a class="menu" asp-controller="Students" asp-action="Index"><i class="bi bi-people-fill"></i><span>Students</span></a>
		}
		@if (role == "Admin" || role == "Principal")
		{
			<a class="menu" asp-controller="Teachers" asp-action="Index">
				<i class="bi bi-person-workspace"></i><span>Teachers</span>
			</a>
			<a class="menu" asp-controller="Classes"
				   asp-action="Index"><i class="bi bi-building"></i><span>Classes & Sections</span></a>

			<a class="menu" asp-controller="Attendance" asp-action="Index">
				<i class="bi bi-calendar2-check-fill"></i><span>Attendance</span>
			</a>
			<a class="menu" asp-controller="Fees"
				   asp-action="Index"><i class="bi bi-cash-stack"></i><span>Fees</span></a>

			<a class="menu" asp-controller="Exams" asp-action="Index"><i class="bi bi-journal-check"></i><span>Examination</span></a>
		}
		@if (role != "Student" && role != "Parent")
		{
			<a class="menu" href="#">
				<i class="bi bi-calendar3"></i><span>Timetable</span>
			</a>
			<a class="menu" href="#">
				<i class="bi bi-book"></i><span>Library</span>
			</a>

			<a class="menu" asp-controller="Transport"
				   asp-action="Index"><i class="bi bi-bus-front-fill"></i><span>Transport</span></a>
			<a class="menu"asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-fill"></i><span>Reports</span></a>
}
		@if (role == "Admin")
		{
			<div class="label">SYSTEM</div>
			<a class="menu" href="#">
				<i class="bi bi-shield-lock-fill"></i><span>Users & Roles</span>
			</a>

			<a class="menu" href="#">
				<i class="bi bi-gear-fill"></i><span>Settings</span>
			</a>
		}
		<div class="sidebar-bottom">
			<a class="menu" asp-controller="Login" asp-action="Logout">
				<i class="bi bi-box-arrow-right"></i><span>Logout</span>
			</a>
		</div>
	</aside>
	<main class="main-content">
		<header class="topbar">
			<button type="button" id="toggle" class="icon sidebar-toggle"
					aria-label="Toggle sidebar">
				<i class="bi bi-list"></i>
			</button>
			<div class="search">
				<i class="bi bi-search"></i><input id="globalSearch" placeholder="Search anything...">
			</div>
			<div class="profile">
				<span class="avatar">@(user.Length > 0 ? user.Substring(0, 1).ToUpper() : "G")</span><span><b>@user</b><small>@role</small></span>
			</div>
		</header>
		<div class="content">@RenderBody()</div>
		<footer>© 2026 EduCore School ERP · @role Portal</footer>
	</main>
	<script src="~/js/site.js"></script>
</body>

</html>