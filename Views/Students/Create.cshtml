<div class="head"><div><span>STUDENT MANAGEMENT</span><h1>New Student</h1><p>Create a student admission record.</p></div><a href="/Students" class="btn btn-light">← Back</a></div><form class="card form"><h3>Personal Information</h3><div class="formgrid"><label>Student Name *<input placeholder="Enter full name"></label><label>Date of Birth<input type="date"></label><label>Gender<select><option>Select</option><option>Male</option><option>Female</option></select></label><label>Admission Number<input value="Auto Generate" disabled></label><label>Class *<select><option>Select Class</option><option>Class 10</option><option>Class 9</option></select></label><label>Section *<select><option>Select Section</option><option>A</option><option>B</option></select></label></div><hr><h3>Parent / Guardian</h3><div class="formgrid"><label>Parent Name *<input placeholder="Enter parent name"></label><label>Mobile Number *<input placeholder="+91"></label><label>Email<input placeholder="parent@example.com"></label><label>Address<input placeholder="Residential address"></label></div><div class="actions"><a href="/Students" class="btn btn-light">Cancel</a><button type="button" class="btn btn-primary" onclick="toast('Student saved successfully')">Save Student</button></div></form>
